<Window x:Class="KlassKlass.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Класс.Класс - Админ" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== ШАПКА ===== -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="40" Height="40">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#A78BFA" Offset="0"/>
                                <GradientStop Color="#60A5FA" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock FontSize="18" FontWeight="Bold" 
                               Margin="10,0,0,0" VerticalAlignment="Center"><Run Text="К"/><Run Language="ru-ru" Text="ласс"/><Run Text=".Класс | Админ"/></TextBlock>
                </StackPanel>
                <Button Content="Выйти" Width="80" Height="30" Background="#E74C3C" 
                        Foreground="White" BorderThickness="0" Cursor="Hand"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="BtnLogout_Click"/>
            </Grid>
        </Border>

        <!-- ===== ОСНОВНОЙ КОНТЕНТ ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">

                <!-- ===== ТАБЛИЦА ПОЛЬЗОВАТЕЛЕЙ ===== -->
                <Border Background="White" Padding="20" Margin="0,0,0,20"
                        BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Пользователи" FontSize="18" FontWeight="Bold" 
                                   Margin="0,0,0,15" Foreground="#333"/>

                        <DataGrid x:Name="DgUsers" AutoGenerateColumns="False" 
                                  Height="250" IsReadOnly="True"
                                  BorderBrush="#E0E0E0" BorderThickness="1"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  RowHeight="40">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="60"/>
                                <DataGridTextColumn Header="Логин" Binding="{Binding login}" Width="*"/>
                                <DataGridTextColumn Header="Пароль" Binding="{Binding password}" Width="*"/>
                                <DataGridTextColumn Header="ФИО" Binding="{Binding fio}" Width="*"/>
                                <DataGridTextColumn Header="Роль" Binding="{Binding role}" Width="100"/>
                                <DataGridTextColumn Header="Группа" Binding="{Binding group_name}" Width="100"/>
                                <DataGridTemplateColumn Header="Действие" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑 Удалить" Width="80" Height="28"
                                                    Background="#E74C3C" Foreground="White"
                                                    BorderThickness="0" Cursor="Hand"
                                                    Click="BtnDeleteUser_Click"
                                                    Tag="{Binding id}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ===== ТАБЛИЦА ПРЕДМЕТОВ ===== -->
                <Border Background="White" Padding="20"
                        BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Предметы" FontSize="18" FontWeight="Bold" 
                                   Margin="0,0,0,15" Foreground="#333"/>

                        <DataGrid x:Name="DgSubjects" AutoGenerateColumns="False" 
                                  Height="250" IsReadOnly="True"
                                  BorderBrush="#E0E0E0" BorderThickness="1"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  RowHeight="40">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="60"/>
                                <DataGridTextColumn Header="Название" Binding="{Binding name}" Width="*"/>
                                <DataGridTextColumn Header="Группа" Binding="{Binding group_name}" Width="100"/>
                                <DataGridTextColumn Header="Цвет" Binding="{Binding color}" Width="100"/>
                                <DataGridTemplateColumn Header="Действие" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑 Удалить" Width="80" Height="28"
                                                    Background="#E74C3C" Foreground="White"
                                                    BorderThickness="0" Cursor="Hand"
                                                    Click="BtnDeleteSubject_Click"
                                                    Tag="{Binding id}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>