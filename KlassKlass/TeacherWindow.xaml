<Window x:Class="KlassKlass.TeacherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кирилл.Класс - Учитель" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== ЛЕВЫЙ САЙДБАР ===== -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Логотип -->
                <StackPanel Grid.Row="0" VerticalAlignment="Top" Margin="0,20,0,20">
                    <Ellipse Width="80" Height="80" HorizontalAlignment="Center">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#A78BFA" Offset="0"/>
                                <GradientStop Color="#818CF8" Offset="0.5"/>
                                <GradientStop Color="#60A5FA" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="Кирилл.Класс" FontSize="16" FontWeight="Bold" 
                               HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="#4A4A6A"/>
                </StackPanel>

                <!-- Список предметов в сайдбаре -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SidebarSubjectsList" Margin="10,0"/>
                </ScrollViewer>

                <!-- Информация о пользователе -->
                <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="15">
                    <StackPanel>
                        <TextBlock x:Name="TxtUserFIO" FontSize="13" FontWeight="Bold" Foreground="#333"/>
                        <TextBlock Text="Преподаватель" FontSize="12" Foreground="#666" Margin="0,3,0,0"/>
                        <Button Content="Выйти" Width="80" Height="28" Margin="0,10,0,0"
                                Background="#E74C3C" Foreground="White" BorderThickness="0"
                                Cursor="Hand" Click="BtnLogout_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== ОСНОВНОЙ КОНТЕНТ ===== -->
        <Grid Grid.Column="1" Margin="20">

            <!-- ЭКРАН 1: Список предметов (Фото 1) -->
            <ScrollViewer x:Name="MainPanel" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                <WrapPanel x:Name="SubjectsPanel" Margin="0,0,0,20"/>
            </ScrollViewer>

            <!-- ЭКРАН 2: Предмет со списком заданий (Фото 2) -->
            <Border x:Name="SubjectPanel" Background="White" CornerRadius="12" 
                    BorderBrush="#E0E0E0" BorderThickness="1" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Синяя шапка -->
                    <Border Grid.Row="0" Background="#A0BFFF" CornerRadius="12,12,0,0" Padding="20">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtSubjectTitle" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                <TextBlock x:Name="TxtSubjectGroup" FontSize="16" Foreground="White" Margin="0,5,0,0"/>
                            </StackPanel>
                            <!-- Кнопка удалить предмет -->
                            <Button Width="45" Height="45" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="White" BorderThickness="0" Cursor="Hand"
                                    Click="BtnDeleteSubject_Click">
                                <TextBlock Text="" FontSize="22"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Кнопка назад -->
                    <Button Grid.Row="0" Content="← Назад" Width="80" Height="30"
                            Background="White" Foreground="#4169E1" BorderThickness="0"
                            Cursor="Hand" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="15,10,0,0" Click="BtnBackToMain_Click"/>

                    <!-- Кнопка добавить задание -->
                    <Button Grid.Row="1" Content="Добавить задание" Width="180" Height="35"
                            Background="#9B59B6" Foreground="White" BorderThickness="0"
                            Cursor="Hand" HorizontalAlignment="Center" Margin="0,15,0,10"
                            Click="BtnAddAssignment_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="17"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Список заданий -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Список заданий" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="#333"/>
                            <StackPanel x:Name="AssignmentsList"/>
                            <TextBlock x:Name="TxtEmptyAssignments" Text="Тут пусто" FontSize="16" 
                                       Foreground="#999" HorizontalAlignment="Center" Margin="0,30,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ЭКРАН 3: Детали задания (Фото 3) -->
            <Border x:Name="AssignmentPanel" Background="White" CornerRadius="12" 
                    BorderBrush="#E0E0E0" BorderThickness="1" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Синяя шапка -->
                    <Border Grid.Row="0" Background="#A0BFFF" CornerRadius="12,12,0,0" Padding="20">
                        <Grid>
                            <TextBlock x:Name="TxtAssignmentTitle" FontSize="22" FontWeight="Bold" 
                                       Foreground="White" VerticalAlignment="Center"/>
                            <!-- Кнопка шестеренка -->
                            <Button Width="45" Height="45" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="White" BorderThickness="0" Cursor="Hand"
                                    Click="BtnEditAssignment_Click">
                                <TextBlock Text="⚙️" FontSize="22"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Кнопка назад -->
                    <Button Grid.Row="0" Content="← Назад" Width="80" Height="30"
                            Background="White" Foreground="#4169E1" BorderThickness="0"
                            Cursor="Hand" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="15,10,0,0" Click="BtnBackToSubject_Click"/>

                    <!-- Контент задания -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Описание:" FontSize="16" FontWeight="Bold" Foreground="#333" Margin="0,0,0,5"/>
                            <TextBlock x:Name="TxtAssignmentDesc" FontSize="14" Foreground="#555" 
                                       TextWrapping="Wrap" Margin="0,0,0,30"/>

                            <!-- Кнопка Сдали -->
                            <Button Content="Сдали" Width="150" Height="40"
                                    Background="#D8B4FE" Foreground="White" BorderThickness="0"
                                    Cursor="Hand" HorizontalAlignment="Center" Margin="0,20,0,0"
                                    Click="BtnShowSubmissions_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="20"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ЭКРАН 4: Список учеников (Фото 4) -->
            <Border x:Name="SubmissionsPanel" Background="White" CornerRadius="12" 
                    BorderBrush="#E0E0E0" BorderThickness="1" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Кнопка назад -->
                    <Button Grid.Row="0" Content="← Назад" Width="80" Height="30"
                            Background="White" Foreground="#4169E1" BorderThickness="0"
                            Cursor="Hand" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="15,0,0,0" Click="BtnBackToAssignment_Click"/>

                    <TextBlock Grid.Row="0" Text="Список" FontSize="22" FontWeight="Bold" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#333"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel x:Name="StudentsList"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- МОДАЛЬНОЕ ОКНО: Прикрепленные работы (Фото 5) -->
            <Border x:Name="ModalOverlay" Background="#80000000" Visibility="Collapsed"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Panel.ZIndex="100">
                <Border Background="White" Width="400" Height="350" CornerRadius="15"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Прикрепленные работы" FontSize="18" FontWeight="Bold" 
                                   HorizontalAlignment="Center" Margin="0,0,0,15" Foreground="#333"/>

                        <WrapPanel x:Name="ModalFilesPanel" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                            <TextBlock Text="Оценка:" FontSize="16" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>
                            <Border Background="#E0E0E0" CornerRadius="10" Padding="15,5" Margin="10,0,0,0">
                                <TextBlock x:Name="TxtModalGrade" Text="0" FontSize="16" FontWeight="Bold" Foreground="#333"/>
                            </Border>
                            <TextBox x:Name="TxtNewGrade" Width="50" Height="30" Margin="10,0,0,0"
                                     FontSize="16" HorizontalContentAlignment="Center"/>
                            <Button Content="OK" Width="50" Height="30" Margin="10,0,0,0"
                                    Background="#4169E1" Foreground="White" BorderThickness="0"
                                    Cursor="Hand" Click="BtnSaveGrade_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

        </Grid>
    </Grid>
</Window>